/**
 * The hub's TEST build: the CI workerd tests (hub/vitest.config.ts) and, from wave 4, the multi-config `wrangler dev`
 * beside the product Worker. Never deployed: scripts/check-hub-config.mjs fails on this file, and the bundle scan
 * requires the test seam's canary in its bundle. Every value here is invented and test-only.
 */
{
	"$schema": "./hub/node_modules/wrangler/config-schema.json",
	"name": "inhouse-hub",
	// Stage 1 M3-R (N30): the test build's own main module, the deployable one's exports plus EvalWriteGateway (the eval
	// deployment's credential-free write log). The deployable config's main stays hub/index/index.ts.
	"main": "hub/testing/entry/index.ts",
	// The newest date the pinned wrangler 4.158.0's workerd supports (app/wrangler.jsonc is on 2026-11-13).
	"compatibility_date": "2026-11-11",
	"workers_dev": false,
	"preview_urls": false,
	"observability": {
		"enabled": true
	},
	"durable_objects": {
		"bindings": [
			{ "name": "SIGNIN", "class_name": "SignIn" },
			{ "name": "SHOPIFY_WRITE_SIGNIN", "class_name": "ShopifyWriteSignIn" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["SignIn"] },
		{ "tag": "v2", "new_sqlite_classes": ["ShopifyWriteSignIn"] }
	],
	// P5 W2: code mode runs scripts in Dynamic Workers (env.LOADER). Exactly this one binding (check-hub-config.mjs).
	"worker_loaders": [{ "binding": "LOADER" }],
	// Turns on the test upstream seam (hub/testing/), together with INHOUSE_TEST_BUILD below.
	"define": {
		"__INHOUSE_HUB_TEST__": "true"
	},
	"vars": {
		"INHOUSE_TEST_BUILD": "1",
		"SHOPIFY_SHOP": "example-fixture",
		"SHOPIFY_CLIENT_ID": "test-client",
		// TEST-ONLY keys, generated for this file and used nowhere else. Two keys, `current` the second, so rotation
		// paths run in tests. A real deployment sets HUB_TOKEN_KEYS as a secret through a secret card.
		"HUB_TOKEN_KEYS": "{\"current\":\"ktest-2\",\"keys\":{\"ktest-1\":\"1Fza49LBSBNRAEZcdP+XApWhY8ZgCJilqS4O7FoBju4=\",\"ktest-2\":\"E32MH18U9aWDv8hY9zmavoxETTkRY4Xad0NJiBsPw2A=\"}}",
		// TEST-ONLY, invented. The recorded upstream accepts it; no real app has it.
		"SHOPIFY_CLIENT_SECRET": "test-only-client-secret-0RW9rVbhXFbVnJw6t1jyOWrJ1E7bMlc6",
		// TEST-ONLY, invented, matching the fake Slack and notes upstreams (test/upstreams/mcp/).
		"SLACK_CLIENT_ID": "0000000000.0000000001",
		"SLACK_CLIENT_SECRET": "test-only-slack-client-secret-9f3b",
		"SLACK_TEAM_ID": "T0TEST0001",
		"SLACK_PRIVATE_SEARCH": "off",
		"CONNECT_REDIRECT_URI": "https://inhouse.example.com/api/connect/callback",
		// P5 W4: invented, the product origin Slack notices link to.
		"APP_ORIGIN": "https://inhouse.example.com",
		// Stage 1 M2-C: TEST-ONLY invented write-scoped Shopify app on its own fake store (never the read fixture).
		"SHOPIFY_WRITE_SHOP": "example-write",
		"SHOPIFY_WRITE_CLIENT_ID": "test-write-client",
		"SHOPIFY_WRITE_CLIENT_SECRET": "test-only-write-client-secret-8d4a2f1c9b0e"
	}
}
