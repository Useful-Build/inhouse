  {
   "id": "r-forecast-sql",
   "name": "stock-forecast.sql",
   "type": "SQL",
   "kind": "code",
   "place": "routines",
   "from": "Routine: Morning check",
   "by": "Inhouse agent",
   "madeByAgent": true,
   "size": "1.3 KB",
   "at": "0d 06:01",
   "link": {
    "to": "routines"
   },
   "text": "-- Days of stock per variant, from the last 14 days of sales\nSELECT v.sku,\n       v.on_hand,\n       ROUND(s.units / 14.0, 1) AS per_day,\n       ROUND(v.on_hand / (s.units / 14.0)) AS days_left\nFROM variants v\nJOIN sales_14d s ON s.sku = v.sku\nWHERE v.on_hand / (s.units / 14.0) < 21\nORDER BY days_left;"
  },
