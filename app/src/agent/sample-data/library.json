   "at": "0d 06:03",
   "link": {
    "to": "routines"
   },
   "text": "from shopify import variants\nfrom shipbob import returns\n\nWAIT_DAYS = 3\n\ndef sellable_returns():\n    \"\"\"Returns ShipBob marked sellable that Shopify still hides.\"\"\"\n    rows = returns.received(min_age_days=WAIT_DAYS, status=\"sellable\")\n    return [r for r in rows if not variants.available(r.sku)]\n\nfor r in sellable_returns():\n    print(\"Restock\", r.units, r.sku)"
  },
