{
  "name": "inhouse-app",
  "private": true,
  "version": "0.1.0",
  "license": "PolyForm-Strict-1.0.0",
  "engines": { "node": ">=24" },
  "type": "module",
  "scripts": {
    "prepare": "git rev-parse --git-dir > /dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:product": "vite build --mode product",
    "build:product-test": "vite build --mode product-test",
    "build:product-eval": "vite build --mode product-eval",
    "test-build:migrate": "node scripts/test-build-d1.mjs migrate",
    "test-build:seed": "node scripts/test-build-d1.mjs seed",
    "lint": "oxlint && npm run lint:tokens",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc -b",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --project=visual-desktop --project=visual-phone",
    "test:visual:update": "playwright test --project=visual-desktop --project=visual-phone --update-snapshots",
    "test:visual:linux": "docker run --rm --init --ipc=host -v \"$PWD\":/work -v /work/node_modules -w /work mcr.microsoft.com/playwright:v1.65.1-noble@sha256:1507cbfc550a63a6b7396791ca4f00df17beb56342d2447b3f106c306f525579 sh -c 'npm ci --no-audit --no-fund && npx playwright test --project=visual-desktop --project=visual-phone'",
    "test:visual:linux:update": "docker run --rm --init --ipc=host -v \"$PWD\":/work -v /work/node_modules -w /work mcr.microsoft.com/playwright:v1.65.1-noble@sha256:1507cbfc550a63a6b7396791ca4f00df17beb56342d2447b3f106c306f525579 sh -c 'npm ci --no-audit --no-fund && npx playwright test --project=visual-desktop --project=visual-phone --update-snapshots'",
    "test:a11y": "playwright test --project=a11y",
    "lint:tokens": "node scripts/check-format.mjs && node scripts/check-tokens.mjs src && node scripts/check-app-rules.mjs && node scripts/check-icons.mjs"
  },
  "dependencies": {
    "@shadcn/react": "0.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "jose": "6.2.15",
    "mermaid": "12.3.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-breaks": "4.0.0",
    "streamdown": "2.8.1",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vite-plugin": "^1.69.1",
    "@cloudflare/vitest-plugin": "1.6.0",
    "@emnapi/core": "2.0.0-beta.3",
    "@emnapi/runtime": "2.0.0-beta.2",
    "@fast-check/vitest": "^0.5.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fast-check": "^4.10.3",
    "jsdom": "31.0.0",
    "oxlint": "^1.90.0",
    "rolldown": "1.2.19",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1",
    "wrangler": "4.162.0",
    "yaml": "2.8.4"
  }
}
