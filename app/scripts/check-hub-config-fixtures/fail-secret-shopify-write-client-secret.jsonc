// Fails: the optional Shopify write secret under vars.
/* "routes": ["not-a-real-route/*"], in a comment: ignored */
{
  "name": "inhouse-hub",
  "main": "hub/index/index.ts",
  "compatibility_date": "2026-11-11",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SIGNIN",
        "class_name": "SignIn"
      },
      {
        "name": "SHOPIFY_WRITE_SIGNIN",
        "class_name": "ShopifyWriteSignIn"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SignIn"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "ShopifyWriteSignIn"
      ]
    }
  ],
  "define": {
    "__INHOUSE_HUB_TEST__": "false"
  },
  "vars": {
    "SHOPIFY_SHOP": "",
    "SHOPIFY_CLIENT_ID": "",
    "SHOPIFY_WRITE_SHOP": "",
    "SHOPIFY_WRITE_CLIENT_ID": "",
    "SHOPIFY_WRITE_CLIENT_SECRET": "x",
    "SLACK_CLIENT_ID": "",
    "SLACK_TEAM_ID": "",
    "SLACK_PRIVATE_SEARCH": "off",
    "CONNECT_REDIRECT_URI": ""
  },
  "secrets": {
    "required": [
      "HUB_TOKEN_KEYS",
      "SHOPIFY_CLIENT_SECRET"
    ]
  },
}
