// Fails secrets-required: no `secrets` key.
{
  "name": "inhouse-hub",
  "main": "hub/index/index.ts",
  "compatibility_date": "2026-11-11",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SIGNIN",
        "class_name": "SignIn"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SignIn"
      ]
    }
  ],
  "define": {
    "__INHOUSE_HUB_TEST__": "false"
  },
  "vars": {
    "SHOPIFY_SHOP": "",
    "SHOPIFY_CLIENT_ID": ""
  }
}
