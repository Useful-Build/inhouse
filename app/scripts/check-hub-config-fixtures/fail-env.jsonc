// Fails env: an env block (here one that would add a custom domain, workers.dev and the test define). The top level is clean.
{
  "name": "inhouse-hub",
  "main": "hub/index/index.ts",
  "compatibility_date": "2026-11-11",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SIGNIN",
        "class_name": "SignIn"
      },
      {
        "name": "SHOPIFY_WRITE_SIGNIN",
        "class_name": "ShopifyWriteSignIn"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SignIn"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "ShopifyWriteSignIn"
      ]
    }
  ],
  "define": {
    "__INHOUSE_HUB_TEST__": "false"
  },
  "vars": {
    "SHOPIFY_SHOP": "",
    "SHOPIFY_CLIENT_ID": ""
  },
  "secrets": {
    "required": [
      "HUB_TOKEN_KEYS",
      "SHOPIFY_CLIENT_SECRET"
    ]
  },
  "env": {
    "prod": {
      "routes": [
        {
          "pattern": "hub.example.invalid",
          "custom_domain": true
        }
      ],
      "workers_dev": true,
      "define": {
        "__INHOUSE_HUB_TEST__": "true"
      }
    }
  }
}
