// Fails secret-in-define: HUB_TOKEN_KEYS baked into the bundle. Invented value.
{
  "name": "inhouse-hub",
  "main": "hub/index/index.ts",
  "compatibility_date": "2026-11-11",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SIGNIN",
        "class_name": "SignIn"
      },
      {
        "name": "SHOPIFY_WRITE_SIGNIN",
        "class_name": "ShopifyWriteSignIn"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SignIn"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "ShopifyWriteSignIn"
      ]
    }
  ],
  "define": {
    "__INHOUSE_HUB_TEST__": "false",
    "HUB_TOKEN_KEYS": "\"not-a-real-key\""
  },
  "vars": {
    "SHOPIFY_SHOP": "",
    "SHOPIFY_CLIENT_ID": ""
  },
  "secrets": {
    "required": [
      "HUB_TOKEN_KEYS",
      "SHOPIFY_CLIENT_SECRET"
    ]
  }
}
