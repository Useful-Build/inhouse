// Fails test-define: no define.
/* "routes": ["not-a-real-route/*"], in a comment: ignored */
{
  "name": "inhouse-hub",
  "main": "hub/index/index.ts",
  "compatibility_date": "2026-11-13",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SIGNIN",
        "class_name": "SignIn"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SignIn"
      ]
    }
  ],
  "vars": {
    "SHOPIFY_SHOP": "",
    "SHOPIFY_CLIENT_ID": ""
  },
  "secrets": {
    "required": [
      "HUB_TOKEN_KEYS",
      "SHOPIFY_CLIENT_SECRET"
    ]
  },
}
