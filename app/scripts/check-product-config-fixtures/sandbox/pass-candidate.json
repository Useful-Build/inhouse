{
	"name": "inhouse-sbx-product",
	"main": "index.js",
	"compatibility_date": "2026-11-13",
	"account_id": "0123456789abcdef0123456789abcdef",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "inhouse-sbx-db",
			"migrations_dir": "server/migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "FILES",
			"bucket_name": "inhouse-sbx-files"
		}
	],
	"routes": [
		{
			"pattern": "inhouse-sbx-brand.zone.example.test",
			"custom_domain": true
		},
		{
			"pattern": "inhouse-sbx-team.zone.example.test",
			"custom_domain": true
		}
	],
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	"vars": {
		"INHOUSE_ACCESS": "{\"teamDomain\":\"https://example-team.cloudflareaccess.com\",\"apps\":[{\"name\":\"brand\",\"origin\":\"https://inhouse-sbx-brand.zone.example.test\",\"aud\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"},{\"name\":\"inhouse\",\"origin\":\"https://inhouse-sbx-team.zone.example.test\",\"aud\":\"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\"}],\"serviceTokens\":{\"monitor-client.access\":\"monitor\",\"smoke-client.access\":\"smoke\"}}"
	},
	"workers_dev": false,
	"preview_urls": false
}
