{
	"name": "inhouse-sbx-pr12-hub",
	"main": "index.js",
	"no_bundle": true,
	"compatibility_date": "2026-11-11",
	"account_id": "0123456789abcdef0123456789abcdef",
	"workers_dev": false,
	"preview_urls": false,
	"observability": {
		"enabled": true
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "SIGNIN",
				"class_name": "SignIn"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"SignIn"
			]
		}
	],
	"vars": {
		"INHOUSE_TEST_BUILD": "1",
		"SHOPIFY_SHOP": "example-fixture",
		"SHOPIFY_CLIENT_ID": "test-client",
		"HUB_TOKEN_KEYS": "{\"current\":\"kfixture\",\"keys\":{\"kfixture\":\"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=\"}}",
		"SHOPIFY_CLIENT_SECRET": "invented-fixture-value"
	},
	"worker_loaders": [
		{
			"binding": "LOADER"
		}
	]
}
