// check-product-config --sandbox fixture: PR 12's test deployment (invented account id and zone, as the test sets
// CF_SANDBOX_ACCOUNT_ID=0123456789abcdef0123456789abcdef and SBX_ZONE=zone.example.test).
{
	"name": "inhouse-sbx-pr12",
	"main": "index.js",
	"compatibility_date": "2026-11-13",
	"account_id": "0123456789abcdef0123456789abcdef",
	"assets": { "binding": "ASSETS", "directory": "../client", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
	"d1_databases": [{ "binding": "DB", "database_name": "inhouse-sbx-pr12-db", "migrations_dir": "server/migrations" }],
	"r2_buckets": [{ "binding": "FILES", "bucket_name": "inhouse-sbx-pr12-files" }],
	"durable_objects": { "bindings": [{ "name": "RUNNER", "class_name": "RunnerContainer" }] },
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["RunnerContainer"] }],
	"containers": [
		{
			"class_name": "RunnerContainer",
			"name": "inhouse-sbx-pr12",
			"image": "registry.cloudflare.com/0123456789abcdef0123456789abcdef/inhouse-sbx-pr12:sha-0a1b2c3",
			"max_instances": 2
		}
	],
	"routes": [
		{ "pattern": "inhouse-sbx-pr12-brand.zone.example.test", "custom_domain": true },
		{ "pattern": "inhouse-sbx-pr12-team.zone.example.test", "custom_domain": true },
	],
	"version_metadata": { "binding": "CF_VERSION_METADATA" },
	"vars": {
		"INHOUSE_TEST_BUILD": "1",
		"INHOUSE_ACCESS": "{\"teamDomain\":\"https://test-issuer.invalid\",\"apps\":[{\"name\":\"brand\",\"origin\":\"https://inhouse-sbx-pr12-brand.zone.example.test\",\"aud\":\"b1a2c3d4e5f60718293a4b5c6d7e8f90b1a2c3d4e5f60718293a4b5c6d7e8f90\"},{\"name\":\"inhouse\",\"origin\":\"https://inhouse-sbx-pr12-team.zone.example.test\",\"aud\":\"0f1e2d3c4b5a69788796a5b4c3d2e1f00f1e2d3c4b5a69788796a5b4c3d2e1f0\"}],\"serviceTokens\":{}}",
		"AUDIT_HASH_KEY": "test-only-audit-hash-key-not-a-secret"
	},
	"workers_dev": false,
	"preview_urls": false,
	"observability": { "enabled": true }
}
