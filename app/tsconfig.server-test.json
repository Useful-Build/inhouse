{
  "extends": "./tsconfig.server.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server-test.tsbuildinfo",
    // The server tests (vitest.config.ts's `server` project, in the Workers runtime): the product Worker's types plus
    // `cloudflare:test`. The code they import is typechecked here too, and without test types in tsconfig.server.json.
    "types": ["./server/worker-configuration.d.ts", "vite/client", "@cloudflare/vitest-plugin/types"],
  },
  "include": ["server/**/*.test.ts", "server/testing", "ops/backup/**/*.test.ts", "ops/retention/**/*.test.ts", "ops/export/**/*.test.ts", "ops/delete/**/*.test.ts"],
  "exclude": []
}
