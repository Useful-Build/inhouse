/**
 * The connector hub (P4): our own gateway Worker in the brand's account. It holds connector tokens in its SignIn
 * Durable Objects and answers only service bindings: no route, no workers.dev URL, no preview URLs.
 * This is the template. No account id, host, shop handle or client id here: the private ops repo fills `vars` per
 * deployment, and the secrets are set through secret cards. scripts/check-hub-config.mjs checks this file in CI.
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "./hub/node_modules/wrangler/config-schema.json",
	"name": "inhouse-hub",
	"main": "hub/index/index.ts",
	// The newest date the pinned wrangler 4.158.0's workerd supports (app/wrangler.jsonc is on 2026-11-13).
	"compatibility_date": "2026-11-11",
	// workers_dev defaults to true when there's no route, and an omitted preview_urls leaves an existing setting alone:
	// both are explicitly false.
	"workers_dev": false,
	"preview_urls": false,
	"observability": {
		"enabled": true
	},
	"durable_objects": {
		"bindings": [
			{ "name": "SIGNIN", "class_name": "SignIn" },
			{ "name": "SHOPIFY_WRITE_SIGNIN", "class_name": "ShopifyWriteSignIn" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["SignIn"] },
		{ "tag": "v2", "new_sqlite_classes": ["ShopifyWriteSignIn"] }
	],
	// P5 W2: code mode runs scripts in Dynamic Workers (env.LOADER). Exactly this one binding (check-hub-config.mjs).
	"worker_loaders": [{ "binding": "LOADER" }],
	// The test upstream seam (hub/testing/) is only in a bundle built with this "true" (wrangler.hub.test.jsonc).
	"define": {
		"__INHOUSE_HUB_TEST__": "false"
	},
	// Empty means not configured. The ops repo fills them per deployment.
	"vars": {
		"SHOPIFY_SHOP": "",
		"SHOPIFY_CLIENT_ID": "",
		// Slack (P5): the pre-registered app's client id and the workspace's team id. CONNECT_REDIRECT_URI is the product's
		// OAuth callback (https://<product host>/api/connect/callback). SLACK_PRIVATE_SEARCH is "off" or "on".
		"SLACK_CLIENT_ID": "",
		"SLACK_TEAM_ID": "",
		"SLACK_PRIVATE_SEARCH": "off",
		"CONNECT_REDIRECT_URI": "",
		// P5 W4: the brand's product origin (https, no path) for the "Open in Inhouse" link in Slack notices.
		"APP_ORIGIN": "",
		// Stage 1 M2-C (N13): the write-scoped Shopify app (separate from the read app). Empty in Stage 1.
		"SHOPIFY_WRITE_SHOP": "",
		"SHOPIFY_WRITE_CLIENT_ID": ""
	},
	// Set with `wrangler secret put` through a secret card, never in a file. SLACK_CLIENT_SECRET is optional (not in
	// `required`): set it the same way once the Slack app exists.
	"secrets": {
		"required": ["HUB_TOKEN_KEYS", "SHOPIFY_CLIENT_SECRET"]
	}
}
