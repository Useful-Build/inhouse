{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["ES2024"],
    "types": ["node"],
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    // app/shared/protocol/ has no node_modules of its own and the app has no zod: resolve it from the runner's.
    "paths": { "zod": ["./node_modules/zod/index.d.ts"] }
  },
  "include": ["src", "test", "scripts", "image/probes", "vitest.config.ts", "../shared/protocol", "../shared/files", "../test/scripted-model"]
}
