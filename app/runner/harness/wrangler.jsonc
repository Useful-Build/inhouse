{
  // The runner harness (P3): local development only (`wrangler dev`), never deployed. One runner container per
  // harness object, through ctx.container on the default scheduling policy. No account ids, hosts or secrets.
  "name": "inhouse-runner-harness",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // Never reachable once deployed: no workers.dev URL, no preview URLs, and the Worker refuses every request unless
  // HARNESS_LOCAL_ONLY=1, which only `npm run dev` passes (`wrangler dev --var`; src/guards.ts).
  "workers_dev": false,
  "preview_urls": false,
  // app/shared/protocol imports zod; resolve it from the harness's own node_modules (the app has none).
  "alias": { "zod": "./node_modules/zod/index.js" },
  "containers": [
    {
      "class_name": "RunnerHarness",
      // The runner's own Dockerfile, built from app/ as CI builds it (it bundles app/shared/protocol).
      "image": "../Dockerfile",
      "image_build_context": "../..",
      "instance_type": "standard-1",
      "max_instances": 2
    }
  ],
  "durable_objects": { "bindings": [{ "name": "HARNESS", "class_name": "RunnerHarness" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RunnerHarness"] }]
}
