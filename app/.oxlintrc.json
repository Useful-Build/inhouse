{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/components/ui/**"
      ],
      "rules": {
        "react/only-export-components": "off"
      }
    },
    {
      "files": [
        "server/egress/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/api/connect",
                  "**/api/connect.ts",
                  "**/api/tools",
                  "**/api/tools.ts",
                  "**/notify-slack",
                  "**/notify-slack/**",
                  "**/tools/notifications/send",
                  "**/tools/notifications/send.ts",
                  "**/tools/notifications/index",
                  "**/tools/notifications/index.ts"
                ],
                "message": "P5 import boundary (p5-orchestrator.md section 2): the runner's egress never reaches the connect, tools or Slack delivery server code. From the notifications tool, only its deps.ts factory (notifyDeps) is allowed."
              },
              {
                "group": [
                  "**/hub/index/contract",
                  "**/hub/index/contract.ts"
                ],
                "importNames": [
                  "ConnectGateway",
                  "DeliveryGateway",
                  "PostNoticeRequest",
                  "SlackChannel"
                ],
                "message": "P5 import boundary: the egress may use the hub's ReadGateway types only, never ConnectGateway or DeliveryGateway."
              }
            ]
          }
        ]
      }
    }
  ]
}
