{
  "name": "inhouse-hub",
  "private": true,
  "version": "0.0.0",
  "license": "PolyForm-Strict-1.0.0",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test:node": "vitest run --project node",
    "test:workers": "vitest run --project workers",
    "test": "vitest run --project node --project workers",
    "types": "wrangler types -c ../wrangler.hub.jsonc --strict-vars false worker-configuration.d.ts",
    "bundle": "wrangler deploy --dry-run --outdir \"$PWD/../dist-hub\" --metafile \"$PWD/../dist-hub/bundle-meta.json\" -c ../wrangler.hub.jsonc",
    "bundle:test": "wrangler deploy --dry-run --outdir \"$PWD/../dist-hub-test\" --metafile \"$PWD/../dist-hub-test/bundle-meta.json\" -c ../wrangler.hub.test.jsonc"
  },
  "dependencies": {
    "graphql": "16.15.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.6.0",
    "@fast-check/vitest": "0.5.0",
    "@types/node": "26.6.6",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "wrangler": "4.158.0"
  }
}
